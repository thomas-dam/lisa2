{
  "_comment": "Voice system configuration. Read by both Node.js Lisa server and Python voice sidecar.",
  "voice_enabled": true,
  "sidecar": {
    "host": "127.0.0.1",
    "port": 3330,
    "base_url": "http://127.0.0.1:3330"
  },
  "asr": {
    "provider": "whispermlx",
    "model": "large-v3",
    "device": "cpu",
    "language": "en"
  },
  "tts": {
    "provider": "mlx-audio",
    "engine": "qwen3",
    "model": "mlx-community/Qwen3-TTS-12Hz-0.6B-Base-8bit",
    "endpoint": "http://127.0.0.1:8000/v1/audio/speech/stream",
    "voice": "rose",
    "language": "auto",
    "streaming_interval": 0.32
  },
  "audio": {
    "tmp_dir": "tmp/voice",
    "cleanup_after_minutes": 60
  }
}
