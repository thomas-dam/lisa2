{
  "name": "lisa2",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm --prefix standalone-bot start",
    "voice": "echo '[npm run voice] Starts local ASR only; use ./start-lisa.sh for the complete runtime.' && bash start-voice.sh",
    "lisa:start": "bash start-lisa.sh",
    "lisa:stop": "bash stop-lisa.sh",
    "lisa:status": "bash status-lisa.sh",
    "lisa:logs": "bash logs-lisa.sh",
    "check": "npm --prefix standalone-bot run check",
    "test": "npm --prefix standalone-bot test",
    "start:detached": "npm --prefix standalone-bot run start:detached",
    "stop": "npm --prefix standalone-bot run stop",
    "serve:https": "npm --prefix standalone-bot run serve:https",
    "serve:off": "npm --prefix standalone-bot run serve:off"
  }
}
